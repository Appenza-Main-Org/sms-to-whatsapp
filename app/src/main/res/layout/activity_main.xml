<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMS to WhatsApp"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bridges matching SMS to a WhatsApp group via a local Baileys server"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: STOPPED"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="#E3F2FD"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filter keywords (comma-separated — matches sender OR message body)"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/senderFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="InstaPay,IPN"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipient WhatsApp group name (exact, case-insensitive)"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/recipient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MAHFOUZ IPN instapay revise"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bridge URL (Baileys server running in Termux on this phone)"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/bridgeUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://127.0.0.1:3000"
            android:inputType="textUri"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/testConnectionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test Bridge Connection"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/bridgeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Queue: empty"
            android:textSize="13sp"
            android:padding="8dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Listener"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop Listener"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/batteryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disable Battery Optimization"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How it works: When a matching SMS arrives, the app POSTs it to the local Baileys server, which sends it to the named WhatsApp group via the multi-device protocol. Works regardless of phone screen state. Run the server in Termux and pair once via QR code."
            android:textSize="12sp"
            android:textStyle="italic" />

    </LinearLayout>
</ScrollView>
